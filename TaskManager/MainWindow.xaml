<Window x:Class="TaskManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0" Margin="0,0,0,20" Background="White" >
            <!--DropShadowEffect adauga iluzia de 3D -->
            <Grid.Effect>
                <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" />
            </Grid.Effect>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <!-- Descrierea ia restul de spatiu -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Calendarul -->
            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Date / Time" FontWeight="Bold" Margin="0,0,0,5"/>
                <DatePicker x:Name="TaskDatePicker" Width="120" Padding="4"/>
            </StackPanel>

            <!-- Titlul -->
            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Short Name" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TaskTitleTextBox" Width="150" Padding="4"/>
            </StackPanel>

            <!-- Descrierea -->
            <StackPanel Grid.Column="2" Margin="10">
                <TextBlock Text="What to do? (Description)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TaskDescTextBox" Padding="4"/>
            </StackPanel>

            <!-- ADD -->
            <Button Grid.Column="3" x:Name="AddTaskButton" Content="Add Task" Width="90" Height="30" Margin="10,20,5,10"
                    Background="#0078D7" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="AddTaskButton_Click"/>

            <!-- SAVE -->
            <Button Grid.Column="4" x:Name="SaveButton" Content="Save to Disk" Width="100" Height="30" Margin="5,20,10,10"
                    Background="#107C10" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="SaveButton_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- TO DO -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="To Do" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ListBox Grid.Row="1" x:Name="ToDoListBox" AllowDrop="True" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" 
                         Padding="5" FontSize="14" Drop="ListBox_Drop" PreviewMouseLeftButtonDown="ListBox_MouseDown"/>
            </Grid>

            <!-- IN PROGRESS -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="In Progress" FontWeight="Bold" FontSize="18" Foreground="#0078D7" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ListBox Grid.Row="1" x:Name="InProgressListBox" AllowDrop="True" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" 
                         Padding="5" FontSize="14" Drop="ListBox_Drop" PreviewMouseLeftButtonDown="ListBox_MouseDown"/>
            </Grid>

            <!-- DONE -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Done" FontWeight="Bold" FontSize="18" Foreground="#107C10" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ListBox Grid.Row="1" x:Name="DoneListBox" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" 
                         Padding="5" FontSize="14" Drop="ListBox_Drop" AllowDrop="True" PreviewMouseLeftButtonDown="ListBox_MouseDown"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <!-- Clear -->
            <Button x:Name="ClearDoneButton" Content="Clear All Done" Width="120" Padding="5" HorizontalAlignment="Right"
                    Background="#D83B01" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="ClearDoneButton_Click" />
        </Grid>

    </Grid>
</Window>